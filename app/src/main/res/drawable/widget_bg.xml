<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:endColor="#EC407A"
                android:centerColor="#2979FF"
                android:startColor="#FFB74D" />
        </shape>
    </item>
    <item
        android:width="86dp"
        android:height="86dp"
        android:gravity="top|right"
        android:right="-24dp"
        android:top="-24dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:bottom="-24dp"
        android:gravity="bottom|left"
        android:left="-12dp">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
